name: Build Android APK

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 45

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      # Runner par Android SDK pehle se installed hai, isliye setup-android action nahi chahiye.
      # Project NDK 27.0.12077973 aur CMake 3.22.1 maangta hai (SpeexDSP echo canceller).
      - name: Install NDK and CMake
        run: |
          SDKM="$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager"
          yes | "$SDKM" --licenses > /dev/null || true
          "$SDKM" --install "ndk;27.0.12077973" "cmake;3.22.1" "platforms;android-35" "build-tools;35.0.0"

      - name: Set up Gradle (with cache)
        uses: gradle/actions/setup-gradle@v4

      - name: Make gradlew executable
        run: chmod +x ./gradlew

      - name: Unit tests
        run: ./gradlew :app:testDebugUnitTest --stacktrace

      # First build downloads the Vosk speech model (36 MB) and checks its SHA-256.
      - name: Build debug APK
        run: ./gradlew :app:assembleDebug --stacktrace

      - name: Upload debug APK
        uses: actions/upload-artifact@v4
        with:
          name: jarvis-debug-apk
          path: app/build/outputs/apk/debug/*.apk
          if-no-files-found: error

      # Optional signed release build. Add these repo secrets to enable it:
      #   KEYSTORE_BASE64    -> base64 of your .jks file   (base64 -w0 release.jks)
      #   KEYSTORE_PASSWORD  -> keystore + key password (key alias must be "jarvis")
      - name: Build signed release APK
        env:
          KEYSTORE_BASE64: ${{ secrets.KEYSTORE_BASE64 }}
          KEYSTORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
        run: |
          if [ -z "$KEYSTORE_BASE64" ]; then
            echo "No KEYSTORE_BASE64 secret set, skipping release build."
            exit 0
          fi
          echo "$KEYSTORE_BASE64" | base64 -d > "$RUNNER_TEMP/release.jks"
          export SHILEX_KEYSTORE="$RUNNER_TEMP/release.jks"
          export SHILEX_KEYSTORE_PASSWORD="$KEYSTORE_PASSWORD"
          ./gradlew :app:assembleRelease --stacktrace
          rm -f "$RUNNER_TEMP/release.jks"

      - name: Upload release APK
        uses: actions/upload-artifact@v4
        with:
          name: jarvis-release-apk
          path: app/build/outputs/apk/release/*.apk
          if-no-files-found: ignore
