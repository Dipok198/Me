name: Build Android APK

on:
  push:
    branches: [main]
  workflow_dispatch:

env:
  ZIP_NAME: jarvis-android-main.zip
  PROJECT_DIR: jarvis-android-main

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 45

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Unzip project
        run: |
          if [ ! -f "$ZIP_NAME" ]; then
            echo "::error::$ZIP_NAME repo ke root mein nahi mili"
            ls -la
            exit 1
          fi
          unzip -q -o "$ZIP_NAME"
          # Agar zip ke andar extra folder na ho to bhi chale
          if [ ! -f "$PROJECT_DIR/gradlew" ]; then
            echo "::error::$PROJECT_DIR/gradlew nahi mila, zip ka structure check karein"
            find . -maxdepth 2 -not -path './.git/*' | head -50
            exit 1
          fi
          chmod +x "$PROJECT_DIR/gradlew"

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - name: Set up Android SDK
        uses: android-actions/setup-android@v3

      # Project NDK 27.0.12077973 aur CMake 3.22.1 maangta hai (SpeexDSP echo canceller)
      - name: Install NDK and CMake
        run: |
          sdkmanager --install "ndk;27.0.12077973" "cmake;3.22.1" "platforms;android-35" "build-tools;35.0.0"

      - name: Set up Gradle (with cache)
        uses: gradle/actions/setup-gradle@v4
        with:
          build-root-directory: ${{ env.PROJECT_DIR }}

      # Pehli build mein Vosk speech model (36 MB) download hota hai
      - name: Build debug APK
        working-directory: ${{ env.PROJECT_DIR }}
        run: ./gradlew :app:assembleDebug --stacktrace

      - name: Upload debug APK
        uses: actions/upload-artifact@v4
        with:
          name: jarvis-debug-apk
          path: ${{ env.PROJECT_DIR }}/app/build/outputs/apk/debug/*.apk
          if-no-files-found: error

      # Optional signed release. Repo secrets: KEYSTORE_BASE64, KEYSTORE_PASSWORD (alias "jarvis")
      - name: Build signed release APK
        working-directory: ${{ env.PROJECT_DIR }}
        env:
          KEYSTORE_BASE64: ${{ secrets.KEYSTORE_BASE64 }}
          KEYSTORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
        run: |
          if [ -z "$KEYSTORE_BASE64" ]; then
            echo "KEYSTORE_BASE64 secret nahi hai, release build skip."
            exit 0
          fi
          echo "$KEYSTORE_BASE64" | base64 -d > "$RUNNER_TEMP/release.jks"
          export SHILEX_KEYSTORE="$RUNNER_TEMP/release.jks"
          export SHILEX_KEYSTORE_PASSWORD="$KEYSTORE_PASSWORD"
          ./gradlew :app:assembleRelease --stacktrace
          rm -f "$RUNNER_TEMP/release.jks"

      - name: Upload release APK
        uses: actions/upload-artifact@v4
        with:
          name: jarvis-release-apk
          path: ${{ env.PROJECT_DIR }}/app/build/outputs/apk/release/*.apk
          if-no-files-found: ignore
